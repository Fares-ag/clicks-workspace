# Normalise line endings. Repo stores LF; Windows working trees get CRLF.
# Without this, a machine with core.autocrlf unset reports every file as
# modified (883 phantom changes, Aug 2026).
* text=auto

*.sh   text eol=lf
*.dart text
*.js   text
*.json text
*.yml  text
*.yaml text
*.md   text

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.zip  binary
*.jar  binary
*.apk  binary
*.keystore binary

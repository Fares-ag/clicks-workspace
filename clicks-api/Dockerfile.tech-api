FROM node:20-bookworm-slim

# Chromium deps for puppeteer (receipts PDF)
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
  && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

COPY clicks-shared ./clicks-shared
COPY clicks-customer-tech-api ./clicks-customer-tech-api

WORKDIR /app/clicks-shared
RUN npm install --omit=dev

WORKDIR /app/clicks-customer-tech-api
RUN npm install --omit=dev

ENV NODE_ENV=production
EXPOSE 5001

CMD ["npm", "start"]

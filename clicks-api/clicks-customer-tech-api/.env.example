MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/clicks?retryWrites=true&w=majority
JWT_SECRET=replace-me-must-match-admin-api
INTERNAL_API_SECRET=replace-me-shared-with-admin-api
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081
PORT=5001
UPLOAD_MAX_BYTES=5242880
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_BLOB_CONTAINER=
# SMS — console (mock) | http (generic) | smsala (SMSala SendSmsV2)
SMS_PROVIDER=console
SMS_FROM=Clicks
# Generic HTTP provider
SMS_HTTP_URL=
SMS_HTTP_AUTH_HEADER=
# SMSala (https://dashboard.smsala.com/ManageApi) — never commit real token
SMSALA_API_TOKEN=
SMSALA_API_URL=https://api2.smsala.com/SendSmsV2
SMSALA_SOURCE_ADDRESS=
SMSALA_MESSAGE_TYPE=1
SMSALA_MESSAGE_ENCODING=1
SMSALA_CALLBACK_URL=
# Soft-launch flags (defaults: on for non-production)
LAUNCH_PUBLIC_SOS=true
LAUNCH_PUBLIC_SIGNUP=true
LAUNCH_REGION=QA
# SOS dispatch window (seconds) — soft-launch recommend 120–180
SOS_BROADCAST_SECONDS=120
# Auto-expire abandoned in_call SOS with no job (minutes)
SOS_IN_CALL_TIMEOUT_MINUTES=15
LOCATION_THROTTLE_MS=4000
SERVICE_NAME=clicks-customer-tech-api
# Server-side Google Maps key (Directions + Geocoding proxy for web/mobile clients)
GOOGLE_MAPS_API_KEY=
# Max distance (meters) from job location required to Start Job
JOB_START_MAX_METERS=200
# Socket.IO Redis adapter — leave empty for single-instance (soft launch)
# Required before TECH_API_INSTANCES > 1
REDIS_URL=

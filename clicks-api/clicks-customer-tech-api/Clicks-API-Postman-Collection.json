    {
      "name": "WebSocket Reference",
      "item": [
        {
          "name": "Health Check (API is running)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            },
            "description": "🔌 **WEBSOCKET EVENTS REFERENCE**\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n**CUSTOMER NAMESPACE** (`/customer`)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n**Client → Server:**\n```\nregister: { customer_id }\ncreate SOS: { customer_id, customer_vehicle_id, latitude, longitude }\ncancelSOS: { sos_id, reason }\n```\n\n**Server → Client:**\n```\nsosCreated: { sos_id, status, expires_at }\nsosInCall: { sos_id, status, message }\ntechnicianAssigned: { job_id, technician, status }\ntechnicianAccepted: { job_id, technician, status, accepted_at }\ntechnicianEnRoute: { job_id, status, en_route_at }\nlocationUpdate: { job_id, latitude, longitude, timestamp }\ntechnicianArrived: { job_id, status, arrived_at }\njobStarted: { job_id, status, started_at }\njobCompleted: { job_id, status, total_amount, receipt, technician }\njobCancelled: { job_id, status, reason, cancelled_at }\nsosExpired: { sos_id }\nsosCancelled: { sos_id }\nerror: { message }\n```\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n**TECHNICIAN NAMESPACE** (`/technician`)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n**Client → Server:**\n```\nregister: { technician_id }\nupdateLocation: { technician_id, latitude, longitude, job_id }\nstartEnRoute: { job_id }\nmarkArrived: { job_id }\nstartJob: { job_id }\npaymentReceived: { job_id, payment_method, notes }\n```\n\n**Server → Client:**\n```\nnewJobAssigned: { job_id, sos_id, customer, vehicle, location, price }\nenRouteConfirmed: { job_id, status, en_route_at }\narrivedConfirmed: { job_id, status, arrived_at, message }\njobStartedConfirmed: { job_id, status, started_at, message }\npaymentConfirmed: { job_id, status, receipt, message }\njobCancelled: { job_id, status, reason, cancelled_at }\nerror: { message }\n```\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n**ADMIN NAMESPACE** (`/admin`)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n**Client → Server:**\n```\nregister: { admin_id }\nsosAccepted: { sos_id, customer_id }\nadminCancelJob: { job_id, customer_id, technician_id, reason }\n```\n\n**Server → Client:**\n```\nnewSOSRequest: { sos_id, customer, vehicle, location, expires_at }\njobCancelled: { job_id, message }\n```\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n**CONNECTION EXAMPLE:**\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n```javascript\nimport { io } from 'socket.io-client';\n\nconst socket = io('http://localhost:5001/customer');\n\nsocket.emit('register', customerId);\n\nsocket.on('technicianAccepted', (data) => {\n  console.log('Technician accepted:', data);\n});\n```"
          }
        }
      ]

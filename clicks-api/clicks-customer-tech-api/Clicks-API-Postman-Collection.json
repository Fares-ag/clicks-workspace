    {
      "name": "Jobs",
      "item": [
        {
          "name": "Get Customer Session (App Resume)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/jobs/customer/session",
              "host": ["{{base_url}}"],
              "path": ["api", "jobs", "customer", "session"]
            },
            "description": "Get customer's active SOS and/or job for app resume.\n\nUse this when customer opens the app to check if they have an active session.\n\nResponse:\n```json\n{\n  \"active_sos\": { ... } | null,\n  \"active_job\": { ... } | null,\n  \"has_active_session\": true | false\n}\n```\n\nFrontend navigation based on status:\n- active_sos.status: 'pending' → SOS Waiting Screen\n- active_sos.status: 'in_call' → SOS In Call Screen\n- active_job.job_status: 'assigned/accepted' → Job Assigned Screen\n- active_job.job_status: 'en_route' → Job Tracking Screen\n- active_job.job_status: 'arrived' → Technician Arrived Screen\n- active_job.job_status: 'in_progress' → Job In Progress Screen\n- active_job.job_status: 'completed' + payment_status != 'paid' → Awaiting Payment Screen"

# Staging — customer-tech-api (.env)
# Copy to: clicks-customer-tech-api/.env on the VPS
# JWT_SECRET and INTERNAL_API_SECRET MUST match admin-api
# NEVER commit a filled copy.

MONGODB_URI=mongodb+srv://REPLACE_DB_USER:REPLACE_DB_PASSWORD@REPLACE_CLUSTER.mongodb.net/clicks_staging?retryWrites=true&w=majority
JWT_SECRET=REPLACE_JWT_SECRET_SHARED_WITH_ADMIN_API
INTERNAL_API_SECRET=REPLACE_INTERNAL_API_SECRET_SHARED_WITH_ADMIN_API

CORS_ORIGINS=https://stg-admin.clicks.qa,https://stg-app.clicks.qa

PORT=5001
UPLOAD_MAX_BYTES=5242880
SERVICE_NAME=clicks-customer-tech-api

# Soft launch — single instance; leave REDIS_URL empty
REDIS_URL=
TECH_API_INSTANCES=1

LAUNCH_PUBLIC_SOS=true
# Soft-launch: give dispatchers more than 60s; expire abandoned Create Job forms
SOS_BROADCAST_SECONDS=120
SOS_IN_CALL_TIMEOUT_MINUTES=15
LAUNCH_PUBLIC_SIGNUP=true
LAUNCH_REGION=QA
LOCATION_THROTTLE_MS=4000

# SMSala
SMS_PROVIDER=smsala
SMS_FROM=REPLACE_REGISTERED_SENDER_ID
SMSALA_API_TOKEN=REPLACE_SMSALA_TOKEN
SMSALA_API_URL=https://api2.smsala.com/SendSmsV2
SMSALA_SOURCE_ADDRESS=REPLACE_REGISTERED_SENDER_ID
SMSALA_MESSAGE_TYPE=1
SMSALA_MESSAGE_ENCODING=1
SMSALA_CALLBACK_URL=

# Optional blob
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_BLOB_CONTAINER=

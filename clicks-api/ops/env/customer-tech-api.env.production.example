# Production — customer-tech-api (.env on VPS)
# Include the Vercel Admin UI origin so Live Map sockets work from the browser.
# NEVER commit a filled copy.

MONGODB_URI=mongodb+srv://REPLACE_DB_USER:REPLACE_DB_PASSWORD@REPLACE_CLUSTER.mongodb.net/clicks?retryWrites=true&w=majority
JWT_SECRET=REPLACE_JWT_SECRET_SHARED_WITH_ADMIN_API
INTERNAL_API_SECRET=REPLACE_INTERNAL_API_SECRET_SHARED_WITH_ADMIN_API

# Admin UI on Vercel + any customer web origins
CORS_ORIGINS=https://admin.clicks.qa

PORT=5001
SERVICE_NAME=clicks-customer-tech-api

# Soft launch: leave REDIS_URL unset; TECH_API_INSTANCES=1
TECH_API_INSTANCES=1

LAUNCH_PUBLIC_SOS=true
LAUNCH_PUBLIC_SIGNUP=true
LAUNCH_REGION=QA

# Server-side Maps key for /api/maps/directions and /api/maps/geocode (not browser-restricted)
GOOGLE_MAPS_API_KEY=REPLACE_SERVER_MAPS_KEY
# Max distance (meters) from job location required to Start Job
JOB_START_MAX_METERS=200

# Firebase push (technician urgent jobs) — JSON on one line
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Azure blob (signatures, receipts)
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_BLOB_CONTAINER=

# SMS (production)
# SMS_PROVIDER=smsala
# SMSALA_API_TOKEN=
# SMSALA_SOURCE_ADDRESS=

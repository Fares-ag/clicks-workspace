# Production — admin-api (.env on VPS)
# After moving Admin UI to Vercel, FRONTEND_URL / CORS_ORIGINS must match the Vercel domain.
# NEVER commit a filled copy.

MONGODB_URI=mongodb+srv://REPLACE_DB_USER:REPLACE_DB_PASSWORD@REPLACE_CLUSTER.mongodb.net/clicks?retryWrites=true&w=majority
JWT_SECRET=REPLACE_JWT_SECRET_SHARED_WITH_TECH_API
JWT_REFRESH_SECRET=REPLACE_JWT_REFRESH_SECRET
INTERNAL_API_SECRET=REPLACE_INTERNAL_API_SECRET_SHARED_WITH_TECH_API

CUSTOMER_TECH_API_URL=http://127.0.0.1:5001

# Admin UI on Vercel (custom domain)
# REQUIRED in production: the admin API now refuses to start without CORS_ORIGINS
# (or FRONTEND_URL) rather than reflecting every origin, and localhost is no
# longer auto-trusted. List EVERY browser front end that calls this API — the
# admin UI, the business portal, and the finance portal (append its origin below).
FRONTEND_URL=https://admin.clicks.qa
CORS_ORIGINS=https://admin.clicks.qa,https://business.clicks.qa

PORT=5000
SERVICE_NAME=clicks-admin-api

# Optional shared count cache. Leave empty for soft launch (in-process Map).
# Set the same REDIS_URL as customer-tech-api when running >1 admin-api instance.
REDIS_URL=

SENTRY_DSN=

AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_EMAIL_FROM=

# Staging — admin-api (.env)
# Copy to: clicks-admin-api/.env on the VPS
# Fill REPLACE_* values from: node scripts/generate-staging-secrets.js
# NEVER commit a filled copy.

MONGODB_URI=mongodb+srv://REPLACE_DB_USER:REPLACE_DB_PASSWORD@REPLACE_CLUSTER.mongodb.net/clicks_staging?retryWrites=true&w=majority
JWT_SECRET=REPLACE_JWT_SECRET_SHARED_WITH_TECH_API
JWT_REFRESH_SECRET=REPLACE_JWT_REFRESH_SECRET
INTERNAL_API_SECRET=REPLACE_INTERNAL_API_SECRET_SHARED_WITH_TECH_API

# Tech API as reached from this host (loopback OK on single VPS)
CUSTOMER_TECH_API_URL=http://127.0.0.1:5001

FRONTEND_URL=https://stg-admin.clicks.qa
CORS_ORIGINS=https://stg-admin.clicks.qa

PORT=5000
SERVICE_NAME=clicks-admin-api

# Soft launch — leave empty (in-process dashboard counts).
REDIS_URL=

SENTRY_DSN=

# Optional until uploads/email required
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_EMAIL_FROM=
